# Ignore dotfiles and underscore files, except tracked ones
_*
.*
!.gitignore
!.dockerignore
!.github/

# Node
node_modules/
dist/
*.tsbuildinfo

# Model weights (published to HF Hub)
*.onnx
*.onnx_data
*.safetensors
*.bin
*.gguf
models/

# Pipeline output (keep reports only)
runs_*/*
!runs_*/*/
runs_*/*/*
!runs_*/*/reports/
