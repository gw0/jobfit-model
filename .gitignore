# Ignore dotfiles and underscore files, except tracked ones
_*
.*
!.gitignore
!.dockerignore
!.github/
!__init__.py

# SQLite scratch files
:memory:*

# Python
__pycache__/
*.pyc
*.egg-info/

# Model weights (published to HF Hub)
*.onnx
*.onnx_data
*.safetensors
*.bin
*.gguf
models/

# Local datasets and runs symlinks
/runs
/datasets

# Pipeline output (keep reports only)
runs_smoke/*
!runs_smoke/*/
runs_smoke/*/*
!runs_smoke/*/reports/
